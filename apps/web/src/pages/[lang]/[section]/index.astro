---
import Base from "../../../layouts/Base.astro";
import {languages,sections,translations,sectionSubtitle,sectionTitle,sectionIntro,path,type Locale,type Section} from "../../../lib/site";
export function getStaticPaths(){return languages.flatMap(lang=>sections.map(section=>({params:{lang,section}})));}
const lang=Astro.params.lang as Locale;
const section=Astro.params.section as Section;
const t=translations[lang];
const title=sectionTitle(lang,section);
const subtitle=sectionSubtitle[lang][section];
const intro=sectionIntro(lang,section);
const practices=section==="pooja"?[
 {name:t.morning,tag:"01"},{name:t.evening,tag:"02"},{name:t.journey,tag:"03"},{name:t.bhiksha,tag:"04"}]:
 section==="prayers"?[{name:t.sarana,tag:"01"},{name:lang==="te"?"మంత్రాలు / స్తోత్రాలు":"Mantras & Stotras",tag:"02"},{name:lang==="te"?"భజనలు":"Bhajans",tag:"03"}]:[];
---
<Base lang={lang} title={title} section={section} description={intro}>
 <section class="interior-hero shell">
  <p class="eyebrow"><span aria-hidden="true">✺</span> {subtitle}</p>
  <div class="page-heading"><div><h1>{title}</h1><p class="lead">{intro}</p></div><div class="page-sigil" aria-hidden="true">✺</div></div>
 </section>
 {section==="search"?
 <section class="shell content-section">
  <div class="paper-card">
    <form id="site-search" role="search">
     <label class="label" for="search-text">{t.filter}</label>
     <div class="search-row"><input id="search-text" name="q" type="search" autocomplete="off" placeholder={t.filter}/><button class="cta primary" type="submit">{t.searchAction}</button></div>
    </form>
    <p class="muted small">{t.searchHelp}</p>
    <div id="search-results" aria-live="polite" class="search-results"></div>
  </div>
 </section>
 :section==="listen"?
 <section class="shell content-section"><div class="paper-card empty-state"><span class="large-sigil" aria-hidden="true">♫</span><p class="eyebrow">{t.notReady}</p><h2>{t.audioEmpty}</h2><p>{t.draft}</p></div></section>
 :section==="pooja"||section==="prayers"?
 <section class="shell content-section">
  <div class="section-heading"><p class="eyebrow">{t.review}</p><h2>{section==="pooja"?t.actionHeader:t.prayers}</h2></div>
  <div class="practice-list">{practices.map(p=><div class="practice-row" role="group" aria-label={p.name}><span class="practice-num">{p.tag}</span><span class="practice-body"><strong>{p.name}</strong><small>{t.soon}</small></span><span class="pending-pill">{t.review}</span></div>)}</div>
  <div class="explain-card"><span aria-hidden="true">◇</span><p>{t.draft}</p></div>
 </section>
 :
 <section class="shell content-section">
  <div class="paper-card"><p class="eyebrow">{t.review}</p><h2>{t.soon}</h2><p>{t.draft}</p><p class="muted small">{section==="pilgrimage"?t.official:t.provenance}</p></div>
 </section>}
 <section class="shell lower-nav"><div class="small-emblem" aria-hidden="true">✺</div><div><p class="eyebrow">SARANAM · THE AYYAPPA JOURNEY</p><p>{t.provenance}</p></div><a class="text-link" href={`/${lang}/`}>{t.home} ↗</a></section>
</Base>
