---
import Base from "../../layouts/Base.astro";
import {languages,translations,pillars,path,sectionTitle,type Locale} from "../../lib/site";
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
const t=translations[lang];
const cards=[
 {label:t.startPooja,description:t.poojaIntro,href:path(lang,"pooja"),symbol:"✦",featured:true},
 {label:t.read,description:t.prayersIntro,href:path(lang,"prayers"),symbol:"☷",featured:false},
 {label:t.listen,description:t.listenIntro,href:path(lang,"listen"),symbol:"♫",featured:false},
 {label:t.deeksha,description:t.deekshaIntro,href:path(lang,"deeksha"),symbol:"◷",featured:false}
];
---
<Base lang={lang} title={t.home} description={t.intro}>
 <section class="hero shell">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-content">
   <div class="aura-line"><span class="star" aria-hidden="true">✺</span> <span>{t.pretitle}</span><span class="line"></span></div>
   <h1>{t.hero}</h1>
   <p class="hero-description">{t.intro}</p>
   <p class="trust-line"><span aria-hidden="true">◇</span> {t.noAccount}</p>
  </div>
  <div class="temple-art" aria-hidden="true"><span class="halo-ring"></span><span class="temple-arch"></span><span class="art-lamp">✺</span><span class="temple-line">SARANAM</span></div>
 </section>
 <section class="shell action-section" aria-labelledby="action-title">
  <div class="section-heading"><p class="eyebrow">01 / {t.quick}</p><h2 id="action-title">{t.actionHeader}</h2></div>
  <div class="action-grid">
   {cards.map((card,i)=><a class:list={["action-card",{"featured":card.featured}]} href={card.href}>
    <div class="card-top"><span class="card-icon" aria-hidden="true">{card.symbol}</span><span class="card-number">0{i+1}</span></div>
    <h3>{card.label}</h3><span class="card-arrow" aria-hidden="true">↗</span>
   </a>)}
  </div>
 </section>
 <section class="shell below-section" aria-labelledby="explore">
  <div class="section-heading"><p class="eyebrow">02 / THE PATH</p><h2 id="explore">{t.explore}</h2></div>
  <div class="pillar-grid">{pillars.map((p,i)=><a class="pillar-card" href={path(lang,p)}><span class="pillar-index">0{i+1}</span><strong>{sectionTitle(lang,p)}</strong><span aria-hidden="true">↗</span></a>)}</div>
 </section>
 <section class="shell privacy-note" aria-labelledby="personal">
  <span aria-hidden="true" class="small-emblem">✺</span><div><h2 id="personal">{t.recent}</h2><p>{t.recentDetail}</p><p class="muted small">{t.draft}</p></div>
 </section>
</Base>
